# Mẫu cấu hình. Chép thành .env rồi điền giá trị. Không commit .env.

# ==================================================================
#  Môi trường (chỉ dev; env.ts chặn host không nằm trong ALLOWED_HOSTS)
# ==================================================================
API_URL=https://logx-api-dev.sonthanh.net.vn
WEB_URL=https://logx-dev.sonthanh.net.vn
TENANT_CODE=CONGTYA
ALLOWED_HOSTS=logx-api-dev.sonthanh.net.vn,logx-dev.sonthanh.net.vn

# ==================================================================
#  Tài khoản theo vai trò (mật khẩu chỉ ghi ở .env)
# ==================================================================
# ADMIN: phân quyền, cấu hình chặng
ADMIN_EMAIL=tung.luu.dvkh_master_data@logxpro.test
ADMIN_PASSWORD=logistic@2026
# CC_K5: Trưởng điều phối, K5 xác nhận doanh thu, định giá, giá mua/bán định mức
CC_K5_EMAIL=tungqlcc@gmail.com
CC_K5_PASSWORD=logistic@2026
# DP_K2: định giá, giá mua/bán định mức, điều phối mọi dịch vụ
DP_K2_EMAIL=tungqldp@gmail.com
DP_K2_PASSWORD=logistic@2026
# K1: khách hàng KH_A, YCBG, BGKH, phiếu dịch vụ, Giá mua đầu vào, Cấu hình đầu mục giá
K1_EMAIL=tungkh@gmail.com
K1_PASSWORD=Logistic@2026
# K1B: K1 thứ hai, không phụ trách KH_A (case truy cập chéo)
K1B_EMAIL=tungkh2@gmail.com
K1B_PASSWORD=Logxpro@2026
# SALE: tài khoản không có quyền module (case 403)
SALE_EMAIL=
SALE_PASSWORD=
SALE2_EMAIL=
SALE2_PASSWORD=

# Tài khoản tạo thêm bởi FLOW-ADM (để trống nếu chưa tạo; case cần tới sẽ báo thiếu)
DP_KHQ_EMAIL=
DP_KHQ_PASSWORD=
DP_HQGS_EMAIL=
DP_HQGS_PASSWORD=
DP_VT_EMAIL=
DP_VT_PASSWORD=
DP_ST_EMAIL=
DP_ST_PASSWORD=
DP_KB_EMAIL=
DP_KB_PASSWORD=
K4_EMAIL=
K4_PASSWORD=
K5_ONLY_EMAIL=
K5_ONLY_PASSWORD=
VIEW_GIA_EMAIL=
VIEW_GIA_PASSWORD=
NO_ROLE_EMAIL=
NO_ROLE_PASSWORD=
# Mật khẩu mặc định khi ADMIN tạo tài khoản mới trong case (đổi lần đầu theo NEW_USER_PASSWORD)
NEW_USER_PASSWORD=Logxpro@2026

# Tenant thứ hai cho FLOW-TEN-001/002 (mã tenant KHÁC TENANT_CODE; bên quản trị hệ thống cấp, web/API không tạo được tenant).
# Để trống thì case ghi Blocked (thiếu môi trường) kèm tên biến còn thiếu, không tính là lỗi.
TENANT_B_CODE=
TENANT_B_EMAIL=
TENANT_B_PASSWORD=
# Id dữ liệu của tenant B (FLOW-TEN-001): bảng giá mua, BGKH, phiếu dịch vụ, chứng từ của phiếu đó, giá bán định mức
TENANT_B_PURCHASE_PRICE_ID=
TENANT_B_RC_ID=
TENANT_B_ORDER_ID=
TENANT_B_DOCUMENT_ID=
TENANT_B_SSP_ID=
# 3 phiếu Hoàn thành của tenant B (FLOW-TEN-002), dạng JSON: ["id1","id2","id3"]
TENANT_B_COMPLETED_ORDER_IDS=
# Lượt xuất Excel chạy nền của CC_K5 đã READY, còn hạn tải (FLOW-TEN-003; chỉ sinh khi xuất > 5.000 phiếu)
CC_ASYNC_EXPORT_ID=

# Token thật đã hết hạn (không bắt buộc) để kiểm thêm trường hợp token hết hạn có chữ ký hợp lệ
EXPIRED_ACCESS_TOKEN=

# Dữ liệu riêng theo testcase. Bỏ trống thì case tương ứng báo Blocked.
PNL_MISSING_FX_ORDER_ID=
FIRST_QUOTE_CUSTOMER_ID=
RFQ_NO_PRICE_ID=
IPS_090_AUTO_RFQ_ID=
IPS_090_SPECIFIC_SSP_ID=
IPS_090_ALL_SSP_ID=
IPS_091_AUTO_RFQ_ID=
IPS_129_RFQ_ID=

# Hậu tố đầu mục thử nghiệm ĐÃ CÓ, mỗi case dùng bộ riêng chưa có giá định mức.
# Tên tương ứng: AT <tên đầu mục P0> <hậu tố>. Bỏ trống thì case báo Blocked.

# ==================================================================
#  Dữ liệu nền có sẵn (id lấy từ web dev)
# ==================================================================
# Khách hàng KH_A do K1 phụ trách, có HĐ Đang hiệu lực
CUSTOMER_A_ID=
# Khách hàng KH_B do K1B phụ trách
CUSTOMER_B_ID=
# KH_C: có HĐ, chưa có BGKH hiệu lực; KH_D: HĐ hết hiệu lực nhưng còn BGKH; KH_E: 2 BGKH hiệu lực chưa mặc định (K1 phụ trách)
CUSTOMER_C_ID=
CUSTOMER_D_ID=
CUSTOMER_E_ID=
# Nhà thầu NT_A (báo giá VND) và NT_B (báo giá USD), Đang hoạt động, HĐ hiệu lực
CONTRACTOR_A_ID=
CONTRACTOR_B_ID=
# NT_C: nhà thầu Ngưng hoạt động (case chặn)
CONTRACTOR_C_ID=
# NT_D (VND) và NT_E (USD): Đang hoạt động, HĐ hiệu lực, chỉ dùng cho case tạo/kích hoạt/ngừng bảng giá mua.
# Kích hoạt bảng mới làm ngừng bảng cũ của cùng nhà thầu (BR39), nên các case này không được đụng bảng NT_A/NT_B mà bộ P0 dùng chung.
CONTRACTOR_D_ID=
CONTRACTOR_E_ID=
# Nhà thầu Dừng hợp tác (BGM-143)
CONTRACTOR_STOPPED_ID=

# Dọn dữ liệu có testRunId (chỉ bật trên môi trường dev được phép)
ALLOW_CLEANUP=false
# Thư mục file thật để upload (10MB, 11MB, 20MB...)
UPLOAD_FILES_DIR=G:/upload-test-files
SIZE_FILES_DIR=G:/test-size-files
