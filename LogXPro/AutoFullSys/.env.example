# Dọn dữ liệu có testRunId (chỉ bật trên môi trường dev được phép)
ALLOW_CLEANUP=false
# Thư mục file thật để upload (10MB, 11MB, 20MB...)
UPLOAD_FILES_DIR=G:/upload-test-files
SIZE_FILES_DIR=G:/test-size-files
