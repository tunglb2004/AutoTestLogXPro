# Tenant thứ hai cho FLOW-TEN-001/002 (mã tenant KHÁC TENANT_CODE; bên quản trị hệ thống cấp, web/API không tạo được tenant).
# Để trống thì case ghi Blocked (thiếu môi trường) kèm tên biến còn thiếu, không tính là lỗi.
TENANT_B_CODE=
TENANT_B_EMAIL=
TENANT_B_PASSWORD=
# Id dữ liệu của tenant B (FLOW-TEN-001): bảng giá mua, BGKH, phiếu dịch vụ, chứng từ của phiếu đó, giá bán định mức
TENANT_B_PURCHASE_PRICE_ID=
TENANT_B_RC_ID=
TENANT_B_ORDER_ID=
TENANT_B_DOCUMENT_ID=
TENANT_B_SSP_ID=
# 3 phiếu Hoàn thành của tenant B (FLOW-TEN-002), dạng JSON: ["id1","id2","id3"]
TENANT_B_COMPLETED_ORDER_IDS=
# Lượt xuất Excel chạy nền của CC_K5 đã READY, còn hạn tải (FLOW-TEN-003; chỉ sinh khi xuất > 5.000 phiếu)
CC_ASYNC_EXPORT_ID=

# Token thật đã hết hạn (không bắt buộc) để kiểm thêm trường hợp token hết hạn có chữ ký hợp lệ
EXPIRED_ACCESS_TOKEN=

