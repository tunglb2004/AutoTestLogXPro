# Mẫu cấu hình. Chỉ chép thành .env khi chưa có .env (không chép đè). Không commit .env.

# ==================================================================
#  ĐỔI TÀI KHOẢN ĐĂNG NHẬP Ở ĐÂY (chỉ cần sửa email, mật khẩu bên dưới)
# ==================================================================

# Tài khoản Lead (Nhân viên kinh doanh): tạo và quản lý Lead, upload HĐ đầu tiên
NVKD_A_EMAIL=
NVKD_A_PASSWORD=

# Tài khoản Khách hàng (Dịch vụ khách hàng): khách hàng và hợp đồng khách hàng
DVKH_A_EMAIL=
DVKH_A_PASSWORD=

# Tài khoản Nhà thầu (Quản lý nhà thầu): nhà thầu và hợp đồng nhà thầu.
# Để trống thì dùng chung tài khoản Khách hàng ở trên.
QLNT_EMAIL=
QLNT_PASSWORD=

# Tài khoản thứ 2 cùng vai trò (không bắt buộc): dùng cho case "người khác",
# chuyển người phụ trách. Để trống thì các case đó báo "Thiếu tài khoản".
NVKD_B_EMAIL=
NVKD_B_PASSWORD=
DVKH_B_EMAIL=
DVKH_B_PASSWORD=
NVKD_C_EMAIL=
NVKD_C_PASSWORD=
DVKH_C_EMAIL=
DVKH_C_PASSWORD=
# userId của tài khoản đã bị khóa (dùng làm người nhận không hợp lệ)
LOCKED_NVKD_USER_ID=
LOCKED_DVKH_USER_ID=
# Token thật đã hết hạn (không bắt buộc) để kiểm case token hết hạn
EXPIRED_ACCESS_TOKEN=

# ==================================================================
#  Môi trường (thường không cần sửa)
# ==================================================================
API_BASE_URL=https://logx-api-dev.sonthanh.net.vn
WEB_BASE_URL=https://logx-dev.sonthanh.net.vn
# Web DEV gửi cố định tenantCode=CONGTYA khi đăng nhập
TENANT_CODE=CONGTYA

# Mã hạng nhà thầu (lấy từ giao diện web: STRATEGIC = Chiến lược, PREFERRED = Ưu tiên, BACKUP = Dự phòng)
CONTRACTOR_TIER_A=PREFERRED
CONTRACTOR_TIER_B=STRATEGIC

# Dọn dữ liệu test có testRunId (chỉ bật trên môi trường dev được phép)
ALLOW_CLEANUP=false

# Thư mục file thật để upload (file 10MB/11MB + other-formats-1mb; file 20MB/21MB có nội dung xem được)
UPLOAD_FILES_DIR=G:/upload-test-files
SIZE_FILES_DIR=G:/test-size-files
# File mẫu import Lead (sheet Lead 13 cột + sheet Danh mục); để trống thì dùng test-data/Mau_Nhap_Lead.xlsx
IMPORT_TEMPLATE_FILE=
